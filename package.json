{
  "name": "jsonviewer-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert \"@smoke|@perf\"",
    "gen:api": "openapi-typescript http://localhost:8000/api/openapi.json -o src/lib/api/schema.d.ts",
    "test:smoke": "playwright test --grep @smoke",
    "test:perf": "playwright test e2e/perf.spec.ts --grep @perf --reporter=list"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@kobalte/core": "^0.13.14",
    "@lezer/highlight": "^1.2.5",
    "@solidjs/router": "^1.0.3",
    "@tanstack/solid-virtual": "^3.13.53",
    "comlink": "^4.4.2",
    "diff": "^9.0.0",
    "lucide-solid": "^1.73.0",
    "solid-js": "^1.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/diff": "^8.0.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.15.0",
    "eslint-plugin-solid": "^0.19.0",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "typescript": "~5.6",
    "typescript-eslint": "^8.72.2",
    "vite": "^6",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "^3.2.7"
  }
}
